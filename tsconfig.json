{
  "compilerOptions": {

    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",

    "types": ["node"],

    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": ["days/**/*", "scripts/**/*"]
}
